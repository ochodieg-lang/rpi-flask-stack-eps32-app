[editor]
line_wrapping=false
line_break_column=72
auto_continue_multiline=true

[file_prefs]
final_new_line=true
ensure_convert_new_lines=false
strip_trailing_spaces=false
replace_tabs=false

[indentation]
indent_width=4
indent_type=1
indent_hard_tab_width=8
detect_indent=false
detect_indent_width=false
indent_mode=2

[project]
name=labapp
base_path=/var/www/lab_app
description=
file_patterns=

[long line marker]
long_line_behaviour=1
long_line_column=72

[files]
current_page=0
FILE_NAME_0=432;Python;0;EUTF-8;1;1;0;%2Fvar%2Fwww%2Flab_app%2Fmain.py;0;4

[VTE]
last_dir=/home/tetra

[build-menu]
NoneFT_00_LB=compile
NoneFT_00_CM=python -m py_compile "%f"
NoneFT_00_WD=
NoneFT_01_LB=Lint with ruff
NoneFT_01_CM=uv run ruff check "%f"
NoneFT_01_WD=
NoneFT_02_LB=Lint
NoneFT_02_CM=pycodestyle --max-line-length
NoneFT_02_WD=
filetypes=None;
EX_00_LB=_Execute
EX_00_CM=uv run "%f"
EX_00_WD=%p
EX_01_LB=Execute without uv
EX_01_CM=python "%f"
EX_01_WD=
Noneerror_regex=(.+):([0-9]+):([0-9]+)
